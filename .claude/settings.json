{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v catalyst >/dev/null 2>&1 && catalyst hook session-start || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v catalyst >/dev/null 2>&1 && catalyst hook user-prompt-submit || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__catalyst__.*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v catalyst >/dev/null 2>&1 && catalyst hook pre-tool-use || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v catalyst >/dev/null 2>&1 && catalyst hook post-tool-use || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v catalyst >/dev/null 2>&1 && catalyst hook subagent-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v catalyst >/dev/null 2>&1 && catalyst hook subagent-stop || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v catalyst >/dev/null 2>&1 && catalyst hook session-end || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__catalyst"
    ]
  }
}
